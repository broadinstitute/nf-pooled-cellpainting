/*
 * NOTE: this only exercises the stub branch. Real (non-stub) execution needs the
 * containers/ashlar/ image built and pushed somewhere - modules/local/stitch/main.nf's
 * container directive is currently a placeholder tag.
 */

nextflow_process {

    name "Test Process STITCH"
    script "../main.nf"
    process "STITCH"

    tag "stitch"
    tag "fast"

    test("stitch - painting - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', arm:'painting', well:'A1', cycle:1, id:'Batch1_Plate1_painting_A1_Cycle1'],
                    [
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-1/Plate_Plate1_Well_A1_Site_1_CorrCHN2.tiff")
                    ]
                ]
                input[1] = file("${projectDir}/assets/stitchcrop/well_site_layouts.json", checkIfExists: true)
                input[2] = "square"                    // round_or_square
                input[3] = true                        // quarter_if_round
                input[4] = 10                          // overlap_pct
                input[5] = 1                            // imperwell
                input[6] = 2                            // rows
                input[7] = 2                            // columns
                input[8] = "Grid: snake by rows"       // stitchorder
                input[9] = true                        // compress
                input[10] = false                       // phenix
                input[11] = "DNA"                       // channame
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("stitch - barcoding - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', arm:'barcoding', well:'A1', cycle:1, id:'Batch1_Plate1_barcoding_A1_Cycle1'],
                    [
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-1/Plate_Plate1_Well_A1_Site_1_CorrCHN2.tiff")
                    ]
                ]
                input[1] = file("${projectDir}/assets/stitchcrop/well_site_layouts.json", checkIfExists: true)
                input[2] = "square"                    // round_or_square
                input[3] = true                        // quarter_if_round
                input[4] = 10                          // overlap_pct
                input[5] = 1                            // imperwell
                input[6] = 2                            // rows
                input[7] = 2                            // columns
                input[8] = "Grid: snake by rows"       // stitchorder
                input[9] = true                        // compress
                input[10] = false                       // phenix
                input[11] = "DNA"                       // channame
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
