/*
 * NOTE: this only exercises the stub branch. Input files are illumination-corrected
 * fixtures reused as stand-ins for stitched well images - only their existence
 * matters for a stub test, not their content.
 */

nextflow_process {

    name "Test Process ALIGN_COMBINED"
    script "../main.nf"
    process "ALIGN_COMBINED"

    tag "align_combined"
    tag "fast"

    test("align_combined - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', well:'A1', id:'Batch1_Plate1_A1'],
                    file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff"),
                    file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/barcoding/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_Cycle01_DNA.tiff"),
                    [
                        [plate:'Plate1', batch:'Batch1', well:'A1', arm_source:'cellpainting', filename:'Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff', channel:'CHN2'],
                        [plate:'Plate1', batch:'Batch1', well:'A1', arm_source:'barcoding', filename:'Plate_Plate1_Well_A1_Site_0_Cycle01_DNA.tiff', cycle:1, channel:'DNA']
                    ]
                ]
                input[1] = 1                            // painting_scalingstring
                input[2] = 1.99                         // barcoding_scalingstring
                input[3] = "DNA"                        // painting_channame
                input[4] = "DAPI"                       // barcoding_channame
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
