/*
 * NOTE: bin/crop.py has not been implemented yet (see main.nf TODOs), so this
 * only exercises the stub branch - the real (non-stub) behavior can't be tested
 * until that script exists. Input files are illumination-corrected fixtures
 * reused as stand-ins for a stitched well image - only their existence matters
 * for a stub test, not their content.
 */

nextflow_process {

    name "Test Process CROP"
    script "../main.nf"
    process "CROP"

    tag "crop"
    tag "fast"

    test("crop - painting - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', arm:'painting', well:'A1', id:'Batch1_Plate1_painting_A1'],
                    file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff")
                ]
                input[1] = 2                            // tileperside
                input[2] = 800                          // final_tile_size
                input[3] = true                          // compress
                input[4] = false                         // phenix
                input[5] = "DNA"                          // channame
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
