                            [well:'B1', site:1, arm:'painting', cycle:1, channel:'CHN2-AF488', frame_index:0, column_prefix:'Orig', filename:'Cycle01_Plate1_B1_Site1_WellB1_PointB1_0001_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3076.ome.tiff'],
                            [well:'B1', site:2, arm:'painting', cycle:1, channel:'CHN2-AF488', frame_index:0, column_prefix:'Orig', filename:'Cycle01_Plate1_B1_Site2_WellB1_PointB1_0002_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3077.ome.tiff'],
                            [well:'B1', site:3, arm:'painting', cycle:1, channel:'CHN2-AF488', frame_index:0, column_prefix:'Orig', filename:'Cycle01_Plate1_B1_Site3_WellB1_PointB1_0003_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3078.ome.tiff'],
                        ],
                    ],
                    [
                        'Cycle01_Plate1_A1_Site0_WellA1_PointA1_0000_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq0000.ome.tiff',
                        'Cycle01_Plate1_A1_Site1_WellA1_PointA1_0001_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq0001.ome.tiff',
                        'Cycle01_Plate1_A1_Site2_WellA1_PointA1_0002_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq0002.ome.tiff',
                        'Cycle01_Plate1_A1_Site3_WellA1_PointA1_0003_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq0003.ome.tiff',
                        'Cycle01_Plate1_A2_Site0_WellA2_PointA2_0000_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq1025.ome.tiff',
                        'Cycle01_Plate1_A2_Site1_WellA2_PointA2_0001_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq1026.ome.tiff',
                        'Cycle01_Plate1_A2_Site2_WellA2_PointA2_0002_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq1027.ome.tiff',
                        'Cycle01_Plate1_A2_Site3_WellA2_PointA2_0003_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq1028.ome.tiff',
                        'Cycle01_Plate1_B1_Site0_WellB1_PointB1_0000_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3075.ome.tiff',
                        'Cycle01_Plate1_B1_Site1_WellB1_PointB1_0001_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3076.ome.tiff',
                        'Cycle01_Plate1_B1_Site2_WellB1_PointB1_0002_ChannelPhalloAF750,CHN2-AF488,DAPI_Seq3077.ome.tiff',
