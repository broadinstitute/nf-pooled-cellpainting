nextflow_process {

    name "Test Process ILLUM_MEANILLUM"
    script "../main.nf"
    process "ILLUM_MEANILLUM"

    tag "modules"
    tag "modules_"
    tag "illum"
    tag "illum/meanillum"
    tag "fast"

    test("averages per-well illum files sharing a basename") {

        when {
            process {
                """
                input[0] = [
                    [ batch:'Batch1', plate:'Plate1', id:'Batch1_Plate1' ], // meta map
                    [   file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("meanillum - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ batch:'Batch1', plate:'Plate1', id:'Batch1_Plate1' ], // meta map
                    [   file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
