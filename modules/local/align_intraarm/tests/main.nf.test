/*
 * NOTE: this only exercises the stub branch. bin/align_intraarm.py's real logic is
 * verified via standalone Python tests (synthetic shift recovery + single-cycle
 * no-op), not via nf-test, since the module's container is still a placeholder
 * (community.wave.seqera.io/library/numpy_python_pip_pillow lacks scipy/scikit-image).
 */

nextflow_process {

    name "Test Process ALIGN_INTRAARM"
    script "../main.nf"
    process "ALIGN_INTRAARM"

    tag "align_intraarm"
    tag "fast"

    test("align_intraarm - barcoding - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', arm:'barcoding', well:'A1', id:'Batch1_Plate1_barcoding_A1'],
                    [
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/barcoding/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_Cycle01_DNA.tiff"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/barcoding/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_Cycle02_A.tiff")
                    ],
                    [
                        [plate:'Plate1', batch:'Batch1', arm:'barcoding', well:'A1', filename:'Plate_Plate1_Well_A1_Site_0_Cycle01_DNA.tiff', cycle:1, channel:'DNA'],
                        [plate:'Plate1', batch:'Batch1', arm:'barcoding', well:'A1', filename:'Plate_Plate1_Well_A1_Site_0_Cycle02_A.tiff', cycle:2, channel:'A']
                    ]
                ]
                input[1] = "DNA"   // channame
                input[2] = 50      // shift_threshold
                input[3] = 0.9     // corr_threshold
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("align_intraarm - painting - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [batch:'Batch1', plate:'Plate1', arm:'painting', well:'A1', id:'Batch1_Plate1_painting_A1'],
                    [
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/images_corrected/painting/Plate1/Plate1-A1-0/Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff")
                    ],
                    [
                        [plate:'Plate1', batch:'Batch1', arm:'painting', well:'A1', filename:'Plate_Plate1_Well_A1_Site_0_CorrCHN2.tiff', cycle:null, channel:'CHN2']
                    ]
                ]
                input[1] = "DNA"   // channame
                input[2] = 50      // shift_threshold
                input[3] = 0.9     // corr_threshold
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
