nextflow_process {

    name "Test Process QC_CHECKDUPLICATEIMAGES"
    script "../main.nf"
    process "QC_CHECKDUPLICATEIMAGES"

    tag "modules"
    tag "modules_"
    tag "qc"
    tag "qc/checkduplicateimages"
    tag "fast"

    test("all unique - passes") {

        when {
            process {
                """
                input[0] = [
                    [ batch:'Batch1', plate:'Plate1' ], // meta map
                    [   file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumCHN2.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumPhalloidin.npy")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("duplicate content - fails the task") {

        when {
            process {
                """
                input[0] = [
                    [ batch:'Batch1', plate:'Plate1' ], // meta map
                    [   file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumCHN2.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumCHN2.npy")
                    ]
                ]
                """
            }
        }

        then {
            assert !process.success
        }

    }

    test("checkduplicateimages - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ batch:'Batch1', plate:'Plate1' ], // meta map
                    [   file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumCHN2.npy"),
                        file("s3://nf-pooled-cellpainting-sandbox/data/test-data/fix-s1-output/Source1/images/Batch1/illum/Plate1/Plate1_IllumDNA.npy")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
